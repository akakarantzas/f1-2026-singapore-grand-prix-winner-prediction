{
  "schema_version": 1,
  "experiment_id": "qualifying-value-v1",
  "target": "official_race_winner_among_forecast_entrants",
  "information_cutoffs": {
    "pre": "before_grand_prix_qualifying_start",
    "post": "first_complete_grand_prix_qualifying_classification",
    "penalties": "excluded_without_publication_time_evidence"
  },
  "dataset": {
    "race_universe": "baseline_training_races",
    "history_completion_delay_hours": 4,
    "historical_provenance": "reconstructed_not_publication_time_verified",
    "include_retirements_and_nonstarters": true
  },
  "development_last_year": 2025,
  "retrospective_year": 2026,
  "validation": {
    "split": "expanding_complete_races",
    "minimum_training_races": 20,
    "minimum_calibration_races": 8,
    "minimum_training_races_for_oof": 8,
    "seed": 42,
    "bootstrap_samples": 2000,
    "block_size": 3,
    "confidence_level": 0.95
  },
  "candidates": [
    "uniform", "qualifying_only", "legacy_pre", "legacy_post",
    "pre_model", "post_model", "post_blend", "post_pace", "post_linear"
  ],
  "blend_weights": [0.5, 0.8, 1.0],
  "floors": [0.0, 0.0005],
  "temperatures": [0.75, 1.0, 1.25, 1.5, 2.0],
  "primary_metric": "mean_race_negative_log_winner_probability",
  "secondary_metrics": ["mean_race_sum_brier", "top1_accuracy", "top3_accuracy", "mean_winner_rank"],
  "selection": {
    "scope": "development_only",
    "eligible_candidates": ["post_model", "post_blend", "post_pace", "post_linear"],
    "log_loss_tie_tolerance": 0.01,
    "simplicity_order": ["post_linear", "post_model", "post_blend", "post_pace"]
  },
  "promotion": {
    "scope": "prospective_only",
    "baseline": "legacy_post",
    "minimum_paired_races": 20,
    "evaluation": "one_fixed_block_of_20_complete_pairs_after_candidate_freeze",
    "log_loss_difference_upper_95_bound": 0.0,
    "maximum_brier_regression": 0.0,
    "maximum_top1_regression": 0.0,
    "require_equal_coverage": true,
    "require_parity_and_leakage_checks": true
  }
}
